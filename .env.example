# Copy to .env. Every Settings field in app/config.py can be set here with the FINSIGHT_ prefix.

# Free Gemini API key from https://aistudio.google.com (no card needed).
GEMINI_API_KEY=

# Default roles (free tier; check your limits on AI Studio's rate-limits page):
#   answers        gemini-3.5-flash-lite   15/min, 500/day
#   query parsing  gemma-4-26b-a4b-it      30/min, 14,400/day, 16K tokens/min
#   eval judge     gemma-4-26b-a4b-it      (a different model family grades the answers)
#   table summaries gemini-3.5-flash-lite  (one-off at index time, ~240 batched calls for FinanceBench)
# FINSIGHT_ANSWER_MODEL=gemini:gemini-3.5-flash-lite
# FINSIGHT_FAST_MODEL=gemini:gemma-4-26b-a4b-it
# FINSIGHT_JUDGE_MODEL=gemini:gemma-4-26b-a4b-it
# FINSIGHT_SUMMARY_MODEL=gemini:gemini-3.5-flash-lite
# For a live demo, Flash writes better answers but allows only 20 requests/day:
# FINSIGHT_ANSWER_MODEL=gemini:gemini-3.8-flash

# Unlimited local dev runs: send every role to Ollama (`ollama pull llama3.1:8b` first).
# FINSIGHT_MODEL_OVERRIDE=ollama:llama3.1:8b

# Optional paid provider: FINSIGHT_ANSWER_MODEL=anthropic:claude-opus-5 plus ANTHROPIC_API_KEY=...

# SEC EDGAR requires a descriptive User-Agent with a contact email.
FINSIGHT_SEC_USER_AGENT="FinSight research you@example.com"

# Use the Docker Qdrant (docker compose up -d). Leave unset for the embedded on-disk store.
# FINSIGHT_QDRANT_URL=http://localhost:6333

# Refuse when the best reranked passage scores below this (sigmoid of the cross-encoder logit).
# FINSIGHT_EVIDENCE_THRESHOLD=0.05
